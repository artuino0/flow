# Copiar a .env y ajustar antes de correr en local.
# Usada por drizzle-kit para generar/aplicar migraciones (rol con privilegios de owner).
DATABASE_URL=postgresql://erp_admin:changeme@localhost:5433/erp_dinamico
# Usada en runtime por Nitro. erp_app NO es superusuario, por eso la RLS de
# Postgres (HU-ERD-12) aplica de verdad. Se crea en erp-dinamico-database/init/002_app_role.sql.
APP_DATABASE_URL=postgresql://erp_app:changeme_app@localhost:5433/erp_dinamico
JWT_SECRET=changeme
APP_PORT=3001
# HU-ERD-20: DSN de Sentry (sentry.io -> tu proyecto -> Settings -> Client Keys).
# Vacio = Sentry deshabilitado (no-op), no bloquea nada.
SENTRY_DSN=

# ---- HU-ERD-35: patron "Core + Config" - mismo codigo, distinto deployment ----

# saas (default si se omite): un mismo deployment sirve a multiples tenants -
# el login pide explicitamente cual (campo "Organizacion").
# dedicated: instancia de un solo cliente - el login resuelve el unico tenant
# solo, sin pedirlo (falla con 500 si la base no tiene exactamente un tenant).
APP_MODE=saas

# Solo para el paquete on-premise (npm run build:onprem). El directorio debe
# persistir entre reinicios; en Docker, montarlo como volumen. En contenedor
# Linux se debe montar el machine-id DEL HOST en una ruta de solo lectura y
# apuntar esta variable a esa ruta (no usar el machine-id del contenedor).
# FLOWERP_LICENSE_DIR=/var/lib/flowerp/license
# FLOWERP_MACHINE_ID_FILE=/run/host-machine-id

# Feature flags: convencion FEATURE_<NOMBRE>, leidos por server/utils/appConfig.ts.
# Habilitados por default (variable ausente = habilitado); "false" o "0" los apaga.
# FEATURE_DASHBOARD apaga GET /api/dashboard/metrics (HU-ERD-31, 404) y oculta
# el link/pantalla del dashboard (HU-ERD-34) - end-to-end, no solo cosmetico.
FEATURE_DASHBOARD=true

# Branding por deployment - reservado para cuando exista theming real
# (expuesto ya en runtimeConfig.public.brand, todavia sin aplicar a la UI).
APP_BRAND_PRIMARY_COLOR=
APP_BRAND_LOGO_URL=

# ---- HU-ERD-84: gestion de usuarios - invitacion por correo real ----
# URL publica de esta app (sin barra final), usada para armar el enlace del
# correo de invitacion (https://tu-dominio.com/invitacion/<token>). Sin
# setear, cae a http://localhost:APP_PORT (3000 por defecto). En Vercel es
# obligatorio definir una URL pública propia.
APP_BASE_URL=http://localhost:3000
# Orígenes adicionales autorizados para abrir el WebSocket (separados por
# coma). Los navegadores en el mismo dominio ya están permitidos. Útil para
# un cliente Tauri servido desde un origen distinto al API.
REALTIME_ALLOWED_ORIGINS=
# Credenciales SMTP para el envio real de correos (invitaciones de usuario,
# server/utils/mailer.ts, y desde HU-ERD-50 tambien la accion "email" de un
# trigger). Sin estas 5 variables completas, invitar un usuario falla con
# 500, y la accion "email" de un trigger falla de forma permanente - no hay
# fallback silencioso a "no enviar nada".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Flow <no-responder@tu-dominio.com>"
# Amazon SES con dominio propio por organizacion (SES Tenant Management,
# server/utils/sesTenants.ts): cada organizacion registra su dominio en
# Ajustes > API e integraciones > Correo saliente, y SES mide su reputacion por
# separado (si una se pasa de rebotes/quejas solo se pausa esa). Si se deja
# vacio, la opcion no aparece y se usa SMTP como hasta ahora.
#   SES_SMTP_USER / SES_SMTP_PASSWORD: credenciales SMTP de SES (se generan en
#   la consola de SES, no son las de IAM). AWS_ACCESS_KEY_ID /
#   AWS_SECRET_ACCESS_KEY (o el rol del entorno) deben poder usar la API de SES
#   (tenants, identidades y configuration sets) en SES_REGION.
SES_REGION=
SES_SMTP_USER=
SES_SMTP_PASSWORD=
# Opcionales (por defecto email-smtp.<SES_REGION>.amazonaws.com y 587):
SES_SMTP_HOST=
SES_SMTP_PORT=587
# Cola de trabajos (server/utils/jobQueue.ts): los correos de automatizaciones se
# encolan y salen a un ritmo controlado, con reintentos. En un servidor de larga
# vida el proceso corre solo cada minuto. En Vercel (serverless) se desactiva y
# el mismo ciclo se invoca desde Vercel Cron: GET /api/cron/job-queue con
# `Authorization: Bearer <CRON_SECRET>` (agrega en vercel.json:
# "crons": [{ "path": "/api/cron/job-queue", "schedule": "* * * * *" }]; el
# minuto a minuto requiere plan Pro). Sin CRON_SECRET esa ruta responde 503.
CRON_SECRET=
# Cachés en memoria de vida corta (server/utils/shortCache.ts): ahorran viajes a la base
# en cada petición (importa sobre todo con la base en otra red, p. ej. Neon desde Vercel).
# Son por instancia: una escritura hecha en ESA instancia los invalida al instante; en otras
# instancias un cambio (permiso, sesión revocada, módulo editado) se nota a lo más al vencer
# el tiempo. Valor en milisegundos; 0 lo desactiva.
#   SESSION_CACHE_TTL_MS   validación de sesión (10000)
#   ACCESS_CACHE_TTL_MS    permisos de un rol sobre un módulo (5000)
#   METADATA_CACHE_TTL_MS  definición de un módulo: campos, diseños, relaciones (30000)
SESSION_CACHE_TTL_MS=10000
ACCESS_CACHE_TTL_MS=5000
METADATA_CACHE_TTL_MS=30000
# Tamaño del pool de conexiones a Postgres por proceso (por defecto 10). En serverless usa el
# pooler del proveedor y un valor bajo (3 a 5).
DB_POOL_MAX=
# Ritmo maximo de envios por segundo (mantenlo por debajo del limite de tu proveedor, p. ej. SES).
JOB_QUEUE_RATE_PER_SECOND=10
# Otros ajustes opcionales: JOB_QUEUE_BATCH_SIZE (40), JOB_QUEUE_PER_TENANT_LIMIT (10 por ronda y organizacion),
# JOB_QUEUE_CONCURRENCY (4), JOB_QUEUE_BUDGET_MS (45000). JOB_QUEUE_ENABLED=false lo apaga.
# Clave usada para cifrar credenciales SMTP guardadas desde Ajustes. En
# producción usa un valor aleatorio largo y estable; si se omite se deriva
# de JWT_SECRET para mantener compatibilidad local.
SETTINGS_ENCRYPTION_KEY=

# ---- HU-ERD-49: ejecucion de acciones de trigger (webhook firmado) ----
# Secreto HMAC-SHA256 usado para firmar el POST de una accion "webhook"
# (header X-Trigger-Signature) cuando el trigger_actions.config de esa accion
# NO trae su propio "secret". Sin ninguno de los dos, la accion falla de
# forma permanente (no se manda un webhook sin firmar).
TRIGGER_WEBHOOK_DEFAULT_SECRET=
# Deshabilita el job de reintentos (node-cron cada minuto, server/plugins/trigger-retries.ts) - tests/CI/debug local.
TRIGGER_RETRY_ENABLED=true

# ---- Epica ERD-46: Reporteria con IA (hermana de Triggers/ERD-47) ----
# Feature flag de punta a punta (mismo patron que FEATURE_DASHBOARD): apaga
# POST/GET /api/reports/* (404) y oculta la seccion "Reportes" del menu.
FEATURE_REPORTS=true
# API key de GIPHY para el selector de GIFs del chat. Se obtiene en
# developers.giphy.com/dashboard. Sin esta clave el botón permanece oculto.
GIPHY_API_KEY=
# Proveedor de IA que traduce la descripcion en lenguaje natural de un
# reporte a la consulta real (server/utils/aiProvider.ts) - decision
# explicita del usuario (2026-09-05): configurable, no atado a un solo
# proveedor. "anthropic" u "openai"; sin ninguno de los dos, generar un
# reporte falla explicito (500) en vez de fallar en silencio.
AI_PROVIDER=
# Requeridas solo si AI_PROVIDER=anthropic. ANTHROPIC_MODEL es opcional
# (default: claude-sonnet-5) - ajustar segun los modelos disponibles al
# momento del deployment (ver docs.claude.com).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Requeridas solo si AI_PROVIDER=openai. OPENAI_MODEL es opcional (default:
# gpt-4o-mini).
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Flow Sites: dominios personalizados en Vercel ----
# Token de Vercel con acceso al proyecto que sirve todos los dominios de los tenants.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Solo si el proyecto pertenece a un team de Vercel.
VERCEL_TEAM_ID=
# Valores DNS mostrados en la interfaz. Usa los valores exactos que Vercel
# indique para tu proyecto si difieren de estos targets generales.
SITES_APEX_IP=76.76.21.21
SITES_CNAME_TARGET=cname.vercel-dns-0.com

# ---- Almacenamiento de archivos ----
# El mismo driver y credenciales sirven para archivos, CFDI y CSD.
# local funciona sin servicios externos y es el valor por defecto en desarrollo y on premise.
# r2 usa el bucket existente de Flow, separado por prefijos de tenant.
STORAGE_DRIVER=local
FILES_STORAGE_DIR=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=flow-production

# ---- Suscripción SaaS de Flow con Stripe ----
# Stripe procesa el cobro; Flow conserva el estado del plan, límites,
# facturas SaaS y consumo. Nunca uses estas llaves en el cliente.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs creados en Stripe para cada plan. Son secretos de configuración
# de plataforma; un tenant nunca puede modificarlos desde Ajustes.
STRIPE_PRICE_INICIO_MONTHLY=
STRIPE_PRICE_INICIO_ANNUAL=
STRIPE_PRICE_CRECIMIENTO_MONTHLY=
STRIPE_PRICE_CRECIMIENTO_ANNUAL=
STRIPE_PRICE_ESCALA_MONTHLY=
STRIPE_PRICE_ESCALA_ANNUAL=
# Captura una muestra diaria de consumo por tenant a las 00:10 CDMX.
BILLING_USAGE_SNAPSHOTS_ENABLED=true
# Limite de tiempo para la ruta cron de reintentos de triggers (default: 40000ms)
TRIGGER_RETRY_BUDGET_MS=40000
# Límite de ejecución del ETL OLAP por cron (default: 45000ms)
OLAP_ETL_BUDGET_MS=45000
