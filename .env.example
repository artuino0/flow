# Copiar a .env y ajustar antes de correr en local.
# Usada por drizzle-kit para generar/aplicar migraciones (rol con privilegios de owner).
DATABASE_URL=postgresql://erp_admin:changeme@localhost:5433/erp_dinamico
# Usada en runtime por Nitro. erp_app NO es superusuario, por eso la RLS de
# Postgres (HU-ERD-12) aplica de verdad. Se crea en erp-dinamico-database/init/002_app_role.sql.
APP_DATABASE_URL=postgresql://erp_app:changeme_app@localhost:5433/erp_dinamico
JWT_SECRET=changeme
APP_PORT=3001
# HU-ERD-20: DSN de Sentry (sentry.io -> tu proyecto -> Settings -> Client Keys).
# Vacio = Sentry deshabilitado (no-op), no bloquea nada.
SENTRY_DSN=

# ---- HU-ERD-35: patron "Core + Config" - mismo codigo, distinto deployment ----

# saas (default si se omite): un mismo deployment sirve a multiples tenants -
# el login pide explicitamente cual (campo "Organizacion").
# dedicated: instancia de un solo cliente - el login resuelve el unico tenant
# solo, sin pedirlo (falla con 500 si la base no tiene exactamente un tenant).
APP_MODE=saas

# Feature flags: convencion FEATURE_<NOMBRE>, leidos por server/utils/appConfig.ts.
# Habilitados por default (variable ausente = habilitado); "false" o "0" los apaga.
# FEATURE_DASHBOARD apaga GET /api/dashboard/metrics (HU-ERD-31, 404) y oculta
# el link/pantalla del dashboard (HU-ERD-34) - end-to-end, no solo cosmetico.
FEATURE_DASHBOARD=true

# Branding por deployment - reservado para cuando exista theming real
# (expuesto ya en runtimeConfig.public.brand, todavia sin aplicar a la UI).
APP_BRAND_PRIMARY_COLOR=
APP_BRAND_LOGO_URL=

# ---- HU-ERD-84: gestion de usuarios - invitacion por correo real ----
# URL publica de esta app (sin barra final), usada para armar el enlace del
# correo de invitacion (https://tu-dominio.com/invitacion/<token>). Sin
# setear, cae a http://localhost:APP_PORT - sirve para desarrollo local pero
# un deployment real DEBE setearla o el enlace del correo no sera abrible.
APP_BASE_URL=http://localhost:3001
# Orígenes adicionales autorizados para abrir el WebSocket (separados por
# coma). Los navegadores en el mismo dominio ya están permitidos. Útil para
# un cliente Tauri servido desde un origen distinto al API.
REALTIME_ALLOWED_ORIGINS=
# Credenciales SMTP para el envio real de correos (invitaciones de usuario,
# server/utils/mailer.ts, y desde HU-ERD-50 tambien la accion "email" de un
# trigger). Sin estas 5 variables completas, invitar un usuario falla con
# 500, y la accion "email" de un trigger falla de forma permanente - no hay
# fallback silencioso a "no enviar nada".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FlowERP <no-responder@tu-dominio.com>"
# Clave usada para cifrar credenciales SMTP guardadas desde Ajustes. En
# producción usa un valor aleatorio largo y estable; si se omite se deriva
# de JWT_SECRET para mantener compatibilidad local.
SETTINGS_ENCRYPTION_KEY=

# ---- HU-ERD-49: ejecucion de acciones de trigger (webhook firmado) ----
# Secreto HMAC-SHA256 usado para firmar el POST de una accion "webhook"
# (header X-Trigger-Signature) cuando el trigger_actions.config de esa accion
# NO trae su propio "secret". Sin ninguno de los dos, la accion falla de
# forma permanente (no se manda un webhook sin firmar).
TRIGGER_WEBHOOK_DEFAULT_SECRET=
# Deshabilita el job de reintentos (node-cron cada minuto, server/plugins/trigger-retries.ts) - tests/CI/debug local.
TRIGGER_RETRY_ENABLED=true

# ---- Epica ERD-46: Reporteria con IA (hermana de Triggers/ERD-47) ----
# Feature flag de punta a punta (mismo patron que FEATURE_DASHBOARD): apaga
# POST/GET /api/reports/* (404) y oculta la seccion "Reportes" del menu.
FEATURE_REPORTS=true
# Proveedor de IA que traduce la descripcion en lenguaje natural de un
# reporte a la consulta real (server/utils/aiProvider.ts) - decision
# explicita del usuario (2026-09-05): configurable, no atado a un solo
# proveedor. "anthropic" u "openai"; sin ninguno de los dos, generar un
# reporte falla explicito (500) en vez de fallar en silencio.
AI_PROVIDER=
# Requeridas solo si AI_PROVIDER=anthropic. ANTHROPIC_MODEL es opcional
# (default: claude-sonnet-5) - ajustar segun los modelos disponibles al
# momento del deployment (ver docs.claude.com).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Requeridas solo si AI_PROVIDER=openai. OPENAI_MODEL es opcional (default:
# gpt-4o-mini).
OPENAI_API_KEY=
OPENAI_MODEL=
